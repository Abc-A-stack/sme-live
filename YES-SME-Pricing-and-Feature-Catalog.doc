          <h3 class="facility-title">à¦¬à¦¾à¦‚à¦²à¦¾à¦¯à¦¼ à¦à¦†à¦‡ (AI) à¦¬à¦¿à¦œà¦¨à§‡à¦¸ à¦‡à¦¨à¦¸à¦¾à¦‡à¦Ÿ</h3>
          <p class="facility-desc">
            à¦¸à¦¹à¦œ à¦¬à¦¾à¦‚à¦²à¦¾à§Ÿ à¦ªà§à¦°à¦¶à§à¦¨ à¦•à¦°à§‡à¦‡ à¦œà§‡à¦¨à§‡ à¦¨à¦¿à¦¨ à¦¬à§à¦¯à¦¬à¦¸à¦¾à¦° à¦¸à¦¾à¦°à§à¦¬à¦¿à¦• à¦…à¦¬à¦¸à§à¦¥à¦¾â€”à¦¯à§‡à¦®à¦¨: "à¦†à¦œà¦•à§‡à¦° à¦®à§‹à¦Ÿ à¦²à¦¾à¦­ à¦•à¦¤?", "à¦•à¦¾à¦° à¦•à¦¾à¦›à§‡ à¦¸à¦¬à¦šà§‡à§Ÿà§‡ à¦¬à§‡à¦¶à¦¿ à¦¬à¦•à§‡à§Ÿà¦¾?"à¥¤ à¦à¦•à§à¦¸à§‡à¦² à¦¶à¦¿à¦Ÿ à¦–à§‹à¦à¦œà¦¾à¦° à¦à¦¾à¦®à§‡à¦²à¦¾ à¦›à¦¾à§œà¦¾à¦‡ à¦šà§‹à¦–à§‡à¦° à¦ªà¦²à¦•à§‡ à¦¸à¦ à¦¿à¦• à¦‰à¦¤à§à¦¤à¦°à¥¤
          </p>
        </div>

        <!-- Facility 5 -->
        <div class="facility-card">
          <div class="facility-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75"/>
            </svg>
          </div>
          <h3 class="facility-title">à¦¸à§‡à¦²à¦¸ à¦Ÿà¦¾à¦°à§à¦—à§‡à¦Ÿ à¦“ à¦•à¦®à¦¿à¦¶à¦¨ à¦…à¦Ÿà§‹à¦®à§‡à¦¶à¦¨</h3>
          <p class="facility-desc">
            à¦¬à¦¿à¦•à§à¦°à¦¯à¦¼à¦•à¦°à§à¦®à§€à¦¦à§‡à¦° à¦¬à§à¦¯à¦•à§à¦¤à¦¿à¦—à¦¤ à¦Ÿà¦¾à¦°à§à¦—à§‡à¦Ÿ à¦¨à¦¿à¦°à§à¦§à¦¾à¦°à¦£, à¦ªà¦¾à¦°à¦«à¦°à¦®à§à¦¯à¦¾à¦¨à§à¦¸ à¦Ÿà§à¦°à§à¦¯à¦¾à¦•à¦¿à¦‚ à¦à¦¬à¦‚ à¦Ÿà¦¿à¦¯à¦¼à¦¾à¦°-à¦­à¦¿à¦¤à§à¦¤à¦¿à¦• à¦¸à§‡à¦²à¦¸ à¦•à¦®à¦¿à¦¶à¦¨ à¦¸à§à¦¬à¦¯à¦¼à¦‚à¦•à§à¦°à¦¿à¦¯à¦¼à¦­à¦¾à¦¬à§‡ à¦¹à¦¿à¦¸à¦¾à¦¬ à¦¹à§Ÿà§‡ à¦¸à¦°à¦¾à¦¸à¦°à¦¿ à¦®à¦¾à¦¸à¦¿à¦• à¦ªà§‡-à¦°à§‹à¦²à§‡ à¦¯à§à¦•à§à¦¤ à¦¹à¦¬à§‡à¥¤
          </p>
        </div>

        <!-- Facility 6 -->
        <div class="facility-card">
          <div class="facility-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          </div>
          <h3 class="facility-title">à¦¨à¦¿à¦œà¦¸à§à¦¬ à¦¬à§à¦°à§à¦¯à¦¾à¦¨à§à¦¡à§‡à¦° à¦®à§‹à¦¬à¦¾à¦‡à¦² à¦…à§à¦¯à¦¾à¦ª</h3>
          <p class="facility-desc">
            à¦†à¦®à¦¾à¦¦à§‡à¦° Medium à¦“ High à¦ªà§à¦¯à¦¾à¦•à§‡à¦œà§‡ à¦†à¦ªà¦¨à¦¾à¦° à¦¨à¦¿à¦œà¦¸à§à¦¬ à¦¬à§à¦°à§à¦¯à¦¾à¦¨à§à¦¡à¦¿à¦‚à§Ÿà§‡ à¦¡à§‡à¦¡à¦¿à¦•à§‡à¦Ÿà§‡à¦¡ Android à¦à¦¬à¦‚ iOS à¦®à§‹à¦¬à¦¾à¦‡à¦² à¦…à§à¦¯à¦¾à¦ª à¦…à¦¨à§à¦¤à¦°à§à¦­à§à¦•à§à¦¤, à¦¯à¦¾ à¦†à¦ªà¦¨à¦¾à¦° à¦•à¦¾à¦¸à§à¦Ÿà¦®à¦¾à¦°à¦¦à§‡à¦° à¦†à¦§à§à¦¨à¦¿à¦• à¦•à§‡à¦¨à¦¾à¦•à¦¾à¦Ÿà¦¾à¦° à¦¸à§‡à¦°à¦¾ à¦…à¦­à¦¿à¦œà§à¦žà¦¤à¦¾ à¦¦à§‡à¦¬à§‡à¥¤
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 4: Terms, SLAs & Contact -->
    <section>
      <h2 class="section-title">
        <span class="section-num">4</span>
        <span>Implementation, Security &amp; Support Terms</span>
      </h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem;">
        <div style="background: #f8fafc; border: 1px solid var(--border); padding: 0.95rem; border-radius: 6px;">
          <h4 style="font-weight: 700; color: var(--primary-dark); margin-bottom: 0.3rem;">Onboarding &amp; Data Migration</h4>
          <p style="font-size: 0.775rem; color: var(--text-muted); line-height: 1.5;">
            Our technical team assists with product catalog uploads, opening stock entries, customer balances, and thermal printer setups within 24–48 hours of onboarding.
          </p>
        </div>

        <div style="background: #f8fafc; border: 1px solid var(--border); padding: 0.95rem; border-radius: 6px;">
          <h4 style="font-weight: 700; color: var(--primary-dark); margin-bottom: 0.3rem;">Cloud Reliability &amp; Backups</h4>
          <p style="font-size: 0.775rem; color: var(--text-muted); line-height: 1.5;">
            99.9% uptime SLA hosted on AWS and enterprise VPS infrastructure. Automated daily offsite backups with instant one-click data restore capabilities and full SSL encryption.
          </p>
        </div>
      </div>
    </section>

    <!-- Document Footer -->
    <footer class="doc-footer">
      <div class="footer-left">
        <p><strong>YES Bangladesh</strong> — Software &amp; Digital Services Division</p>
        <p>Corporate Office: House 43, Road 16, Nikunja 2, Khilkhet, Dhaka-1229, Bangladesh</p>
        <p>Hotline: 01955345331 | Email: info@yesbangladesh.net | Web: www.yesbangladesh.net</p>
      </div>
      <div class="footer-right">
        <p>© 2026 YES Bangladesh.</p>
        <p>All Rights Reserved.</p>
      </div>
    </footer>

  </main></div>

  <!-- Load Central Pricing Data -->
  <script src="js/pricing-data.js"></script>

  <script>
    // =========================================================================
    // DYNAMIC DATA RENDERER (Produces clean, semantic HTML for both Web & Print)
    // =========================================================================
    const DOC_ICONS = {
      box: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      server: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      globe: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      database: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      branch: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      activity: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      users: `<span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span>`,
      checkCircle: `<span class="check-icon"><span style="color:#1d4ed8; font-weight:bold; font-size:10pt; margin-right:4px;">&#9656;</span></span>`
    };

    document.addEventListener('DOMContentLoaded', () => {
      if (typeof PRICING_DATA === 'undefined') {
        console.error('PRICING_DATA not loaded');
        return;
      }

      renderPricingCardsShowcase();
      renderEnterpriseBox();
      renderComparisonTables();
    });

    function renderPricingCardsShowcase() {
      const container = document.getElementById('pricingCardsShowcase');
      if (!container) return;

      const pkgs = PRICING_DATA.packages;

      const cellsHtml = pkgs.map(pkg => {
        const isPopular = pkg.isPopular;
        const badgeHtml = isPopular 
          ? `<div class="popular-badge-wrap"><span class="popular-badge-tag">★ POPULAR CHOICE</span></div>`
          : `<div class="popular-badge-wrap" style="visibility: hidden;"><span class="popular-badge-tag">&nbsp;</span></div>`;

        // Capacity items (Exact match to red-boxed section in image)
        const capacityItems = [];
        if (pkg.limits.products) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.box}
              <span>Products: <strong>${pkg.limits.products}</strong></span>
            </li>
          `);
        }
        if (pkg.limits.hosting) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.server}
              <span>Hosting: <strong>${pkg.limits.hosting}</strong></span>
            </li>
          `);
        }
        if (pkg.limits.website) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.globe}
              <span>Website: <strong>${pkg.limits.website}</strong></span>
            </li>
          `);
        }
        if (pkg.limits.storage) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.database}
              <span>Storage: <strong>${pkg.limits.storage}</strong></span>
            </li>
          `);
        }
        if (pkg.limits.branches) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.branch}
              <span>Branches: <strong>${pkg.limits.branches}</strong></span>
            </li>
          `);
        }
        if (pkg.limits.traffic) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.activity}
              <span>Traffic: <strong>${pkg.limits.traffic}</strong></span>
            </li>
          `);
        }
        if (pkg.limits.users) {
          capacityItems.push(`
            <li class="capacity-item">
              ${DOC_ICONS.users}
              <span>Admin Users: <strong>${pkg.limits.users}</strong></span>
            </li>
          `);
        }

        const formattedMonthly = Number(pkg.monthlyPrice).toLocaleString('en-US');
        const formattedSetup = Number(pkg.setupFee).toLocaleString('en-US');

        return `
          <td class="pricing-card-cell ${isPopular ? 'is-popular' : ''}">
            ${badgeHtml}

            <div class="card-header">
              <h3 class="package-name">${pkg.name}</h3>
              <p class="package-tagline">${pkg.tagline}</p>
            </div>

            <div class="card-price-box">
              <div class="monthly-price-wrap">
                <span class="currency-sym">৳</span>
                <span class="price-amount">${formattedMonthly}</span>
                <span class="price-unit">/ month</span>
              </div>
              <div class="setup-fee-pill">
                <span>One-time setup:</span>
                <strong>৳${formattedSetup}</strong>
              </div>
            </div>

            <div class="card-capacity-box">
              <div class="capacity-title">Plan Capacity & Quota</div>
              <ul class="capacity-list">
                ${capacityItems.join('')}
              </ul>
            </div>
          </td>
        `;
      }).join('');

      container.innerHTML = `
        <table class="pricing-cards-table" width="100%" cellpadding="0" cellspacing="10" border="0">
          <tr style="page-break-inside:avoid; mso-yfti-irow:0;">
            ${cellsHtml}
          </tr>
        </table>
      `;
    }

    function renderEnterpriseBox() {
      const box = document.getElementById('enterpriseOverview');
      if (!box) return;

      const ent = PRICING_DATA.customEnterprise;
      box.innerHTML = `
        <div class="enterprise-title">
          <span>Enterprise & Custom Architecture: ${ent.name}</span>
          <span style="font-size:0.9rem; color:var(--primary); font-family:var(--font-bengali);">${ent.priceDisplay}</span>
        </div>
        <p class="enterprise-desc">${ent.tagline} Setup: <strong>${ent.setupFeeDisplay}</strong>.</p>
        <div class="enterprise-chips">
          ${ent.highlights.map(h => `<span class="chip">✓ ${h}</span>`).join('')}
        </div>
      `;
    }

    function renderComparisonTables() {
      const container = document.getElementById('comparisonTablesContainer');
      if (!container) return;

      const categories = PRICING_DATA.comparisonCategories;

      let html = '';

      categories.forEach((cat, idx) => {
        html += `
          <div class="cat-table-wrap">
            <table class="comp-table">
              <thead>
                <tr style="page-break-inside:avoid; mso-yfti-irow:0;">
                  <th class="cat-head">${idx + 1}. ${cat.title}</th>
                  <th class="col-p">Starter</th>
                  <th class="col-p">Basic</th>
                  <th class="col-p pop">Medium (Popular)</th>
                  <th class="col-p">High</th>
                </tr>
              </thead>
              <tbody>
                ${cat.features.map(f => {
                  const formatCell = (val) => {
                    if (val === true) return '<span class="chk">✓</span>';
                    if (val === false) return '<span class="crs">—</span>';
                    return `<span class="pill-val">${val}</span>`;
                  };

                  return `
                    <tr style="page-break-inside:avoid; mso-yfti-irow:0;">
                      <td style="width: 44%;">
                        <span class="feat-name">${f.name}</span>
                        ${f.tooltip ? `<span class="feat-sub">${f.tooltip}</span>` : ''}
                      </td>
                      <td class="cell-val">${formatCell(f.starter)}</td>
                      <td class="cell-val">${formatCell(f.basic)}</td>
                      <td class="cell-val" style="background: rgba(239, 246, 255, 0.4);">${formatCell(f.medium)}</td>
                      <td class="cell-val">${formatCell(f.high)}</td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        `;
      });

      container.innerHTML = html;
    }
  </script>


</body></html>
